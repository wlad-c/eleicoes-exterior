{
  "name": "eleicoes-exterior",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --outDir docs --emptyOutDir",
    "lint": "oxlint",
    "preview": "vite preview --outDir docs",
    "sync:tse": "node scripts/build-city-2022.mjs && node scripts/sync-tse-zz.mjs && node scripts/build-location-map.mjs && node scripts/sync-tse-locations.mjs && node scripts/apply-place-names.mjs",
    "sync:brazil": "node scripts/sync-tse-brazil.mjs",
    "build:brazil-locals": "node scripts/build-brazil-locals.mjs",
    "sync:locations": "node scripts/sync-tse-locations.mjs",
    "build:locations": "node scripts/build-location-map.mjs",
    "build:city-2022": "node scripts/build-city-2022.mjs",
    "apply:city-2022": "node scripts/apply-city-2022.mjs",
    "apply:abbrevs": "node scripts/apply-country-abbrevs.mjs",
    "apply:place-names": "node scripts/apply-place-names.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
